<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large">{% endif %}
{% if not noindex %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/img/brand/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/brand/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{% set ogImg = site.url + (ogImage or site.ogImage) %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if not noindex %}<meta property="og:url" content="{{ site.url }}{{ page.url }}">{% endif %}
<meta property="og:image" content="{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Kible, le SaaS des équipes terrain des installateurs IRVE et photovoltaïques">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImg }}">
<link rel="preload" href="/assets/fonts/sora-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script>document.documentElement.classList.add("js")</script>
<style>{% inlineCss %}</style>
<script type="application/ld+json">{{ page | jsonLd(site, schema, faq[faqKey], title) | safe }}</script>
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#contenu">Aller au contenu</a>
{% include "partials/header.njk" %}
<main id="contenu" class="site-main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/menu.js" defer></script>
{%- for js in scripts %}
<script src="/assets/js/{{ js }}" defer></script>
{%- endfor %}
</body>
</html>
