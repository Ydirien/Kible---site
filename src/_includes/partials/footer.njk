<footer class="site-footer">
  {% include "partials/topo.njk" %}
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="brand brand--footer">
        <img class="brand__logo" src="/assets/img/brand/kible-symbole.svg" alt="Kible" width="40" height="40">
        <span class="brand__name" aria-hidden="true">kible</span>
      </p>
      <p class="site-footer__baseline">{{ site.tagline }}.</p>
      <p class="site-footer__cta"><a class="btn btn--grad" href="{{ site.demoUrl }}">Demander une démo</a></p>
    </div>
    <nav class="site-footer__nav" aria-label="Pied de page">
      <div class="site-footer__col">
        <h2 class="site-footer__title">Produit</h2>
        <ul class="site-footer__list">
          {%- for l in navigation.footer.produit %}<li><a href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></li>{% endfor %}
          <li><a href="{{ site.appUrl }}">Se connecter</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <h2 class="site-footer__title">Solutions</h2>
        <ul class="site-footer__list">
          {%- for l in navigation.footer.solutions %}<li><a href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></li>{% endfor %}
        </ul>
      </div>
      <div class="site-footer__col">
        <h2 class="site-footer__title">Informations</h2>
        <ul class="site-footer__list">
          {%- for l in navigation.footer.legal %}<li><a href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.label }}</a></li>{% endfor %}
        </ul>
      </div>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p>© {{ site.year }} {{ site.name }}. Tous droits réservés.</p>
    <p>Conçu pour les équipes terrain de la transition énergétique.</p>
  </div>
</footer>
